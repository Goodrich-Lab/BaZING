Package: BaHZING
Title: Bayesian Hierarchical Zero-Inflated Negative Binomial Regression
    with G-Computation
Version: 1.1.0
Authors@R: c(
    person("Hailey", "Hampson", , "hhampson@usc.edu", role = "aut"),
